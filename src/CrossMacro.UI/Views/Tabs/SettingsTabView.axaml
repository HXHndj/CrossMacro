<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossMacro.UI.ViewModels"
             xmlns:designVm="using:CrossMacro.UI.ViewModels.Design"
             xmlns:controls="using:CrossMacro.UI.Controls"
             xmlns:localization="using:CrossMacro.UI.Localization"
             xmlns:icons="using:CrossMacro.UI.Icons"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="400"
             x:Class="CrossMacro.UI.Views.Tabs.SettingsTabView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <designVm:DesignSettingsViewModel/>
    </Design.DataContext>

    <Panel>
        <ScrollViewer Padding="0" 
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">

                <!-- Hotkey Info -->
                <Border Classes="page-card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="card-title" Text="{localization:Loc Settings_GlobalHotkeys}"/>

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                             <controls:HotkeyCapture Grid.Row="0" Grid.Column="0"
                                                     x:Name="RecordingHotkeyCapture"
                                                     Hotkey="{Binding RecordingHotkey, Mode=TwoWay}"
                                                    LocalizationService="{Binding LocalizationService}"
                                                    GlobalHotkeyService="{Binding GlobalHotkeyService}"
                                                    Margin="0,0,12,8"
                                                    MinWidth="140"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{localization:Loc Settings_ToggleRecording}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                             <controls:HotkeyCapture Grid.Row="1" Grid.Column="0"
                                                     x:Name="PlaybackHotkeyCapture"
                                                     Hotkey="{Binding PlaybackHotkey, Mode=TwoWay}"
                                                    LocalizationService="{Binding LocalizationService}"
                                                    GlobalHotkeyService="{Binding GlobalHotkeyService}"
                                                    Margin="0,0,12,8"
                                                    MinWidth="140"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{localization:Loc Settings_TogglePlayback}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                             <controls:HotkeyCapture Grid.Row="2" Grid.Column="0"
                                                     x:Name="PauseHotkeyCapture"
                                                     Hotkey="{Binding PauseHotkey, Mode=TwoWay}"
                                                    LocalizationService="{Binding LocalizationService}"
                                                    GlobalHotkeyService="{Binding GlobalHotkeyService}"
                                                    Margin="0,0,12,0"
                                                    MinWidth="140"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{localization:Loc Settings_PauseResumePlayback}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Tray Icon Settings -->
                <Border Classes="page-card">
                    <StackPanel Spacing="16">
                        <!-- Tray Icon (hidden in Flatpak - D-Bus StatusNotifierItem not supported) -->
                        <Grid Classes="setting-row" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsTraySettingsVisible}">
                            <TextBlock Grid.Column="0"
                                       Text="{localization:Loc Settings_EnableTrayIcon}"
                                       Classes="row-title"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>

                            <ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding EnableTrayIcon}"
                                         OnContent=""
                                         OffContent=""
                                         VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Start minimized depends on tray support because it starts hidden to tray when available -->
                        <Grid Classes="setting-row" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsTraySettingsVisible}">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{localization:Loc Settings_StartMinimized}"
                                           Classes="row-title"
                                       TextWrapping="Wrap"/>
                                <TextBlock Classes="field-hint" Text="{localization:Loc Settings_StartMinimizedDescription}"
                                           
                                           
                                           />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding StartMinimized}"
                                         OnContent=""
                                         OffContent=""
                                         VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Text Expansion -->
                        <Grid Classes="setting-row" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" 
                                       Text="{localization:Loc Settings_EnableTextExpansion}" 
                                       Classes="row-title"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                                      
                            <ToggleSwitch Grid.Column="1" 
                                         IsChecked="{Binding EnableTextExpansion}"
                                         OnContent="" 
                                         OffContent=""
                                         VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Update Check -->
                        <Grid Classes="setting-row" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsUpdateSettingsVisible}">
                            <TextBlock Grid.Column="0" 
                                       Text="{localization:Loc Settings_CheckForUpdates}" 
                                       Classes="row-title"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                                      
                            <ToggleSwitch Grid.Column="1" 
                                         IsChecked="{Binding CheckForUpdates}"
                                         OnContent="" 
                                         OffContent=""
                                         VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Log Level -->
                        <Grid Classes="setting-row" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{localization:Loc Settings_LogLevel}" 
                                           Classes="row-title"
                                       TextWrapping="Wrap"/>
                                <TextBlock Classes="field-hint" Text="{localization:Loc Settings_LogLevelDescription}" 
                                           
                                           
                                           />
                            </StackPanel>
                            
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LogLevels}"
                                      SelectedItem="{Binding SelectedLogLevel}"
                                      Width="180"
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Theme -->
                        <Grid Classes="setting-row" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{localization:Loc Settings_Theme}" 
                                           Classes="row-title"
                                       TextWrapping="Wrap"/>
                                <TextBlock Classes="field-hint" Text="{localization:Loc Settings_ThemeDescription}" 
                                            
                                            
                                            />
                                <Button Classes="secondary compact"
                                        Command="{Binding OpenThemesFolderCommand}"
                                        HorizontalAlignment="Left"
                                        Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{icons:AppIcon FolderOpen}" Width="12" Height="12"/>
                                        <TextBlock Text="{localization:Loc Settings_OpenThemesFolder}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            
                            <!-- Fixed 180 total width keeps this row's left/right edges aligned with
                                 the sibling ComboBox rows; the ComboBox absorbs whatever width the
                                 refresh button leaves over. -->
                            <Grid Grid.Column="1"
                                  Width="180"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  VerticalAlignment="Center">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding SelectedTheme}"
                                          VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        Command="{Binding RefreshThemesCommand}"
                                        Padding="8"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{localization:Loc Settings_RefreshThemes}">
                                    <PathIcon Data="{icons:AppIcon Refresh}" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                        </Grid>

                        <Grid Classes="setting-row" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{localization:Loc Settings_Language}"
                                           Classes="row-title"
                                       TextWrapping="Wrap"/>
                                <TextBlock Classes="field-hint" Text="{localization:Loc Settings_LanguageDescription}"
                                           
                                           
                                           />
                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding SelectedLanguageOption}"
                                      Width="180"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>


                <!-- Profile Management -->
                <Border Classes="page-card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="card-title" Text="{localization:Loc Settings_Profiles}"/>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableProfiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="1"
                                    Command="{Binding SwitchProfileAsync}"
                                    Classes="secondary"
                                    MinWidth="96"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{localization:Loc Settings_ProfileSwitch}"/>
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{Binding DeleteSelectedProfileAsync}"
                                    Classes="secondary"
                                    MinWidth="96"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{localization:Loc Settings_ProfileDelete}"/>
                            </Button>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <TextBox Grid.Column="0"
                                     Text="{Binding NewProfileName}"
                                     PlaceholderText="{localization:Loc Settings_ProfileNamePlaceholder}"
                                     VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Command="{Binding CreateProfileAsync}"
                                    Classes="secondary"
                                    MinWidth="96"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{localization:Loc Settings_ProfileNew}"/>
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{Binding RenameSelectedProfileAsync}"
                                    Classes="secondary"
                                    MinWidth="96"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{localization:Loc Settings_ProfileRename}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Support Section -->
                <Border Classes="page-card">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                            <TextBlock Classes="card-title" Text="{localization:Loc Settings_SupportTitle}"/>
                            <TextBlock Classes="field-hint" Text="{localization:Loc Settings_SupportDescription}" 
                                     
                                     
                                     />
                        </StackPanel>
                        
                        <Button Grid.Column="1" 
                                Command="{Binding OpenGitHub}"
                                Classes="primary"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{icons:AppIcon GitHub}" Width="16" Height="16"/>
                                <TextBlock Text="{localization:Loc Settings_StarOnGitHub}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
        
        <!-- Toast Notification -->
        <Border x:Name="ToastNotification"
                Classes="notice-card floating error"
                Padding="14,12"
                Margin="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                IsVisible="False">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                </Transitions>
            </Border.Transitions>
            
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" MaxWidth="320">
                <PathIcon Grid.Column="0"
                                  Data="{icons:AppIcon Warning}"
                                  Classes="notice-icon warning"
                                  Width="18"
                                  Height="18"
                                  VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock x:Name="ToastTitle"
                                Text="{localization:Loc Settings_HotkeyAlreadyAssignedTitle}"
                                Classes="notice-title"/>
                    <TextBlock x:Name="ToastMessage"
                               Text=""
                               Classes="notice-message"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Panel>

</UserControl>
