<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossMacro.UI.ViewModels"
             xmlns:designVm="using:CrossMacro.UI.ViewModels.Design"
             xmlns:core="using:CrossMacro.Core.Models"
             xmlns:tabs="using:CrossMacro.UI.Views.Tabs"
             xmlns:conv="using:CrossMacro.UI.Converters"
             xmlns:icons="using:CrossMacro.UI.Icons"
             xmlns:localization="using:CrossMacro.UI.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             x:Class="CrossMacro.UI.Views.Tabs.TextExpansionTabView"
             x:DataType="vm:TextExpansionViewModel"
             x:Name="Root">

    <Design.DataContext>
        <designVm:DesignTextExpansionViewModel/>
    </Design.DataContext>

    <Panel>
        <ScrollViewer Padding="0">
            <StackPanel Spacing="16">

                <!-- ADD NEW EXPANSION -->
                <Border Classes="page-card">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="card-title" Text="{localization:Loc TextExpansion_AddNewExpansion}"/>

                        <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <!-- Trigger -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock Classes="field-label" Text="{localization:Loc TextExpansion_Trigger}"/>
                                <TextBox PlaceholderText="{localization:Loc TextExpansion_TriggerPlaceholder}"
                                          Text="{Binding TriggerInput, FallbackValue=''}"/>
                            </StackPanel>

                            <!-- Arrow -->
                            <PathIcon Grid.Row="0" Grid.Column="1"
                                      Data="{icons:AppIcon ArrowRight}"
                                      Width="20"
                                      Height="20"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Top"
                                      Margin="12,34,12,0"/>

                            <!-- Replacement -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6">
                                <TextBlock Classes="field-label" Text="{localization:Loc TextExpansion_Replacement}"/>
                                <TextBox PlaceholderText="{localization:Loc TextExpansion_ReplacementPlaceholder}"
                                           Text="{Binding ReplacementInput, FallbackValue='', UpdateSourceTrigger=PropertyChanged}"
                                           AcceptsReturn="True"
                                           TextWrapping="Wrap"
                                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                           MinHeight="96"
                                           MaxHeight="220"/>
                            </StackPanel>
                            <!-- Insertion Mode -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6" Margin="0,16,0,0">
                                <TextBlock Classes="field-label" Text="{localization:Loc TextExpansion_InsertionMode}"/>
                                <ComboBox ItemsSource="{Binding InsertionModes}"
                                          SelectedItem="{Binding SelectedInsertionMode}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static conv:TextExpansionConverters.InsertionModeDisplayText}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Paste Method -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6" Margin="0,12,0,0"
                                        IsVisible="{Binding IsPasteMethodSelectorVisible}">
                                <TextBlock Classes="field-label" Text="{localization:Loc TextExpansion_PasteMethod}"/>
                                <ComboBox ItemsSource="{Binding PasteMethods}"
                                          SelectedItem="{Binding SelectedPasteMethod}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static conv:TextExpansionConverters.PasteMethodDisplayText}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Direct Typing Method -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6" Margin="0,12,0,0"
                                        IsVisible="{Binding IsDirectTypingMethodSelectorVisible}">
                                <TextBlock Classes="field-label" Text="{localization:Loc TextExpansion_DirectTypingMethod}"/>
                                <ComboBox ItemsSource="{Binding DirectTypingMethods}"
                                          SelectedItem="{Binding SelectedDirectTypingMethod}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={x:Static conv:TextExpansionConverters.DirectTypingMethodDisplayText}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Button Content="{localization:Loc TextExpansion_Add}"
                                Classes="primary"
                                Command="{Binding AddExpansionCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- SAVED EXPANSIONS -->
                <Border Classes="page-card"
                        MinHeight="200"
                        IsVisible="{Binding HasExpansions, FallbackValue=False}">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                            <TextBlock Classes="card-title"
                                       VerticalAlignment="Center"
                                       Text="{localization:Loc TextExpansion_SavedExpansions}"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="caption" Text="{Binding ExpansionCountText}"
                                           VerticalAlignment="Center"/>
                                <!-- Trash icon could go here if implementing bulk delete -->
                            </StackPanel>
                        </Grid>

                        <!-- Empty State -->
                        <TextBlock Grid.Row="1"
                                   Text="{localization:Loc TextExpansion_NoSavedExpansions}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !Expansions.Count, FallbackValue=True}"/>

                        <!-- List -->
                        <ScrollViewer Grid.Row="1"
                                      MaxHeight="300"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Expansions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:TextExpansionEntry">
                                    <Border Padding="0,12">
                                        <Grid ColumnDefinitions="Auto,*,Auto">

    <!-- Checkbox -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsEnabled}"
                                                      Command="{Binding #Root.((vm:TextExpansionViewModel)DataContext)?.ToggleExpansionCommand}"
                                                      CommandParameter="{Binding}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"/>

                                            <!-- Content -->
                                            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Trigger, FallbackValue=''}"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           FontWeight="Bold"
                                                           FontSize="14"/>

                                                <PathIcon Grid.Column="1"
                                                          Data="{icons:AppIcon ArrowRight}"
                                                          Width="14"
                                                          Height="14"
                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                          Margin="8,0"/>

                                                <StackPanel Grid.Column="2" Spacing="4">
                                                    <TextBlock Text="{Binding Replacement, FallbackValue=''}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="14"
                                                               TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                         <Border Classes="chip" HorizontalAlignment="Left">
                                                             <TextBlock Text="{Binding InsertionMode, Converter={x:Static conv:TextExpansionConverters.InsertionModeDisplayText}}"/>
                                                         </Border>
                                                         <Border Classes="chip" HorizontalAlignment="Left"
                                                                 IsVisible="{Binding InsertionMode, Converter={x:Static conv:TextExpansionConverters.IsDirectTypingMode}, FallbackValue=False}">
                                                             <TextBlock Text="{Binding DirectTypingMethod, Converter={x:Static conv:TextExpansionConverters.DirectTypingMethodDisplayText}}"/>
                                                         </Border>
                                                         <Border Classes="chip" HorizontalAlignment="Left">
                                                            <Border.IsVisible>
                                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                    <Binding Path="InsertionMode" Converter="{x:Static conv:TextExpansionConverters.IsPasteMode}" FallbackValue="False"/>
                                                                    <Binding Path="#Root.((vm:TextExpansionViewModel)DataContext)?.IsPasteMethodVisible" FallbackValue="False"/>
                                                                </MultiBinding>
                                                            </Border.IsVisible>
                                                            <TextBlock Text="{Binding Method, Converter={x:Static conv:TextExpansionConverters.PasteMethodDisplayText}}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Delete Button -->
                                            <Button Grid.Column="2"
                                                    Classes="row-action danger"
                                                    Background="Transparent"
                                                    Padding="8"
                                                    Command="{Binding #Root.((vm:TextExpansionViewModel)DataContext)?.RemoveExpansionCommand}"
                                                    CommandParameter="{Binding}"
                                                    Cursor="Hand"
                                                    AutomationProperties.Name="{localization:Loc TextExpansion_DeleteTitle}">
                                                <PathIcon Data="{icons:AppIcon Delete}"
                                                                    Width="14"
                                                                    Height="14"
                                                                    Opacity="0.85"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Footer Info -->
                <StackPanel Classes="footer-tip">
                    <PathIcon Data="{icons:AppIcon Tip}" Classes="caption-icon"/>
                    <TextBlock Text="{localization:Loc TextExpansion_EnableInSettingsTip}" Classes="caption"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
