<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossMacro.UI.ViewModels"
             xmlns:designVm="using:CrossMacro.UI.ViewModels.Design"
             xmlns:localization="using:CrossMacro.UI.Localization"
             xmlns:icons="using:CrossMacro.UI.Icons"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="400"
             x:Class="CrossMacro.UI.Views.Tabs.RecordingTabView"
             x:DataType="vm:RecordingViewModel">

    <Design.DataContext>
        <designVm:DesignRecordingViewModel/>
    </Design.DataContext>

    <ScrollViewer Padding="0">
        <StackPanel Spacing="20">
            <Grid ColumnDefinitions="2*,1.5*,*" RowDefinitions="Auto,Auto">
                <!-- Labels Row -->
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{localization:Loc Recording_LabelStatus}" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="label" Text="{localization:Loc Recording_LabelEvents}" Margin="8,0,0,8"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Classes="label" Text="{localization:Loc Recording_LabelState}" Margin="8,0,0,8"/>

                <!-- Status Indicator -->
                <Border Grid.Row="1" Grid.Column="0"
                       Classes="mini-card"
                       ClipToBounds="True"
                       VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding RecordingStatus}" 
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  FontWeight="Medium"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip.Tip="{Binding RecordingStatus}"/>
                    </StackPanel>
                </Border>

                <!-- Event Count -->
                <Border Grid.Row="1" Grid.Column="1"
                       Classes="mini-card"
                       Margin="8,0,0,0"
                       ClipToBounds="True"
                       VerticalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{icons:AppIcon Mouse}" Width="14" Height="14"/>
                            <TextBlock Text="{Binding MouseEventCount}" 
                                      FontWeight="Medium"
                                      FontSize="16"
                                      Foreground="{DynamicResource PrimaryBrush}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{icons:AppIcon Keyboard}" Width="14" Height="14"/>
                            <TextBlock Text="{Binding KeyboardEventCount}" 
                                      FontWeight="Medium"
                                      FontSize="16"
                                      Foreground="{DynamicResource PrimaryBrush}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Quick Stats -->
                <Border Grid.Row="1" Grid.Column="2"
                       Classes="mini-card"
                       Margin="8,0,0,0"
                       VerticalAlignment="Stretch">
                    <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Recording indicator when recording -->
                        <PathIcon Data="{icons:AppIcon Record}"
                                            Width="24"
                                            Height="24"
                                            IsVisible="{Binding IsRecording}"
                                            ToolTip.Tip="{localization:Loc Recording_TooltipRecording}"/>
                        <!-- Ready indicator when not recording -->
                        <PathIcon Data="{icons:AppIcon Success}"
                                            Width="24"
                                            Height="24"
                                            IsVisible="{Binding !IsRecording}"
                                            ToolTip.Tip="{localization:Loc Recording_TooltipReady}"/>
                    </Panel>
                </Border>
            </Grid>

            <!-- Recording Controls Panel -->
            <Border Classes="page-card">
                <StackPanel Spacing="16">
                    <TextBlock Classes="card-title" Text="{localization:Loc Recording_CaptureSettings}"/>

                    <!-- Toggles -->
                    <Grid ColumnDefinitions="*,*">
                        <Border Classes="nested-panel" Grid.Column="0" 
                                Margin="0,0,6,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <PathIcon Data="{icons:AppIcon Mouse}" Width="16" Height="16"/>
                                    <TextBlock Text="{localization:Loc Recording_Mouse}" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" 
                                             IsChecked="{Binding IsMouseRecordingEnabled}"
                                             OnContent="" OffContent=""
                                             VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Classes="nested-panel" Grid.Column="1" 
                                Margin="6,0,0,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <PathIcon Data="{icons:AppIcon Keyboard}" Width="16" Height="16"/>
                                    <TextBlock Text="{localization:Loc Recording_Keyboard}" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" 
                                             IsChecked="{Binding IsKeyboardRecordingEnabled}"
                                             OnContent="" OffContent=""
                                             VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- Coordinate Settings -->
                    <StackPanel Spacing="8">
                        <Border Classes="nested-panel" Background="{DynamicResource BackgroundBrush}"
                                IsVisible="{Binding IsForceRelativeSupported}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <PathIcon Data="{icons:AppIcon Location}" Width="16" Height="16"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{localization:Loc Recording_ForceRelativeCoordinates}" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <TextBlock Text="{localization:Loc Recording_ForceRelativeCoordinatesDescription}" 
                                                  Classes="field-hint"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Help Tooltip -->
                                <Border Classes="help-badge" Grid.Column="1" 
                                        Margin="0,0,12,0" 
                                        Width="20" Height="20"
                                        ToolTip.Tip="{localization:Loc Recording_ForceRelativeCoordinatesHelp}">
                                    <TextBlock Text="?"/>
                                </Border>

                                <ToggleSwitch Grid.Column="2" 
                                             IsChecked="{Binding ForceRelativeCoordinates}"
                                             OnContent="" OffContent=""
                                             VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Logical-relative recording option - only visible when Force Relative is enabled -->
                        <Border Classes="nested-panel" Background="{DynamicResource BackgroundBrush}"
                                Margin="24,0,0,0"
                                IsVisible="{Binding ShowLogicalRelativeCoordinatesOption}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <PathIcon Data="{icons:AppIcon Location}" Width="16" Height="16"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{localization:Loc Recording_LogicalRelativeCoordinates}" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <TextBlock Text="{localization:Loc Recording_LogicalRelativeCoordinatesDescription}"
                                                   Classes="field-hint"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Classes="help-badge" Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Width="20" Height="20"
                                        ToolTip.Tip="{localization:Loc Recording_LogicalRelativeCoordinatesHelp}">
                                    <TextBlock Text="?"/>
                                </Border>

                                <ToggleSwitch Grid.Column="2"
                                               IsChecked="{Binding UseLogicalRelativeCoordinates}"
                                               IsEnabled="{Binding IsLogicalRelativeCoordinatesAvailable}"
                                               AutomationProperties.Name="{localization:Loc Recording_LogicalRelativeCoordinates}"
                                               OnContent="" OffContent=""
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Skip 0,0 option - only visible when Force Relative is enabled -->
                        <Border Classes="nested-panel" Background="{DynamicResource BackgroundBrush}"
                                Margin="24,0,0,0"
                                IsVisible="{Binding ShowSkipZeroZeroOption}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <PathIcon Data="{icons:AppIcon ArrowNorthEast}" Width="16" Height="16"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{localization:Loc Recording_SkipInitialZeroZero}" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <TextBlock Text="{localization:Loc Recording_SkipInitialZeroZeroDescription}" 
                                                  Classes="field-hint"/>
                                    </StackPanel>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" 
                                             IsChecked="{Binding SkipInitialZeroZero}"
                                             OnContent="" OffContent=""
                                             VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Action Button (Toggle) -->
                    <Button Name="RecordingToggleButton"
                           Classes="recording-toggle"
                           Classes.recording="{Binding IsRecording}"
                           Command="{Binding ToggleRecordingCommand}"
                           IsEnabled="{Binding CanToggleRecording}"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center">
                        <Panel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsRecording}">
                                <PathIcon Data="{icons:AppIcon Play}" Width="16" Height="16"/>
                                <TextBlock Text="{localization:Loc Recording_StartRecording}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRecording}">
                                <PathIcon Data="{icons:AppIcon Stop}" Width="16" Height="16"/>
                                <TextBlock Text="{localization:Loc Recording_StopRecording}"/>
                            </StackPanel>
                        </Panel>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel Classes="footer-tip">
                <PathIcon Data="{icons:AppIcon Tip}" Classes="caption-icon"/>
                <TextBlock Text="{localization:Loc Recording_Tip}" Classes="caption"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

</UserControl>
